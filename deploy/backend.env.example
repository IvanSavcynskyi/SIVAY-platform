# Use the existing RDS endpoint and an application database/user.
# Single-quote passwords containing $ to avoid Compose interpolation.
POSTGRES_SERVER=your-database.eu-north-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=sivay_app
POSTGRES_PASSWORD='replace-with-database-password'
POSTGRES_DB=sivay_db
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
